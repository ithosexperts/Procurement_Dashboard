# ==============================================================================
# Procurement Dashboard - Environment Configuration (.env)
# ==============================================================================

# Application environment: development | staging | production
APP_NAME=Procurement Dashboard
ENVIRONMENT=development
PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ── Company API Gateway (PHP REST SQL Gateway) ──────────────────────────────
API_BASE_URL=https://api.hosexperts.com:85/apiv2.php
API_AUTH_TOKEN=
API_USERNAME=
API_PASSWORD=
# Target database: Test_OperationsDB (for validation) or OperationsDB (production)
API_DATABASE=Test_OperationsDB
API_TIMEOUT=30.0

# ── One Portal SSO Authentication ──────────────────────────────────────────
# Enables One Portal SSO ticket validation and route protection
ONE_PORTAL_AUTH_ENABLED=false
ONE_PORTAL_IDENTITY_CAPTURE_ENABLED=true
SSO_BASE_URL=https://accounts.hosexperts.com
# 48+ character secret registered in One Portal for this application
PROCUREMENT_SSO_SECRET=
SSO_TICKET_AUDIENCE=procurement-dashboard
SSO_SESSION_MINUTES=480
# Use 'lax' for standalone browser app, or 'none' if embedded in cross-origin iframe
SSO_COOKIE_SAMESITE=lax
JWT_ALGORITHM=HS256

# ── Application Secrets & Logging ──────────────────────────────────────────
SECRET_KEY=change-me-in-production-random-secret-key-32-chars
LOG_LEVEL=INFO
