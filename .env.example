# ==============================================================================
# Procurement Dashboard - Environment Configuration (.env)
# Simple standalone procurement analytics application
# ==============================================================================

# Application environment: development | staging | production
APP_NAME=Procurement Dashboard
ENVIRONMENT=development
PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ── Company API Gateway (PHP REST SQL Gateway) ──────────────────────────────
API_BASE_URL=https://api.hosexperts.com:85/apiv3.php
API_AUTH_TOKEN=
API_USERNAME=
API_PASSWORD=
# Target database: Test_OperationsDB (for validation) or OperationsDB (production)
API_DATABASE=OperationsDB
API_TIMEOUT=30.0

# ── Application Secrets & Logging ──────────────────────────────────────────
SECRET_KEY=change-me-in-production-random-secret-key-32-chars
LOG_LEVEL=INFO
